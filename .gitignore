# Model checkpoint — 556 MB, distributed as a GitHub Release asset.
*.pth
*.ckpt

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Local convenience symlinks into the engine repo's dataset, so the tests here
# can reach data the public repo must never carry. Committing them would publish
# a broken absolute path into someone's home directory.
data/cache
data/images
data/manifest.parquet
data/Data
data/val

# Generated build context: docker/build_and_test.sh copies src/fubio here at
# build time, so the image's package is always exactly the current source.
docker/fubio/

# Training / inference outputs
wandb_logs/
predictions/
checkpoints/
.coverage
